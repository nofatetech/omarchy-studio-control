#!/usr/bin/env python3
"""Discover registered Studio Control modules through Linux USB sysfs."""

from __future__ import annotations

import json
from pathlib import Path


PLUGIN_ROOT = Path(__file__).resolve().parent.parent
DEVICES_ROOT = PLUGIN_ROOT / "devices"
USB_ROOT = Path("/sys/bus/usb/devices")


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError):
        return ""


def usb_inventory() -> list[dict[str, str]]:
    inventory: list[dict[str, str]] = []
    if not USB_ROOT.is_dir():
        return inventory

    for path in sorted(USB_ROOT.iterdir()):
        vendor_id = read_text(path / "idVendor").lower()
        product_id = read_text(path / "idProduct").lower()
        if not vendor_id or not product_id:
            continue
        inventory.append(
            {
                "path": str(path),
                "vendorId": vendor_id,
                "productId": product_id,
                "manufacturer": read_text(path / "manufacturer"),
                "product": read_text(path / "product"),
            }
        )
    return inventory


def load_modules(inventory: list[dict[str, str]]) -> list[dict[str, object]]:
    modules: list[dict[str, object]] = []
    for manifest_path in sorted(DEVICES_ROOT.glob("*/device.json")):
        try:
            manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError) as error:
            modules.append(
                {
                    "id": manifest_path.parent.name,
                    "name": manifest_path.parent.name,
                    "connected": False,
                    "error": f"Invalid device manifest: {error}",
                }
            )
            continue

        matches = manifest.get("match", {}).get("usb", [])
        matched_device = None
        for candidate in inventory:
            if any(
                candidate["vendorId"] == str(match.get("vendorId", "")).lower()
                and candidate["productId"]
                == str(match.get("productId", "")).lower()
                for match in matches
            ):
                matched_device = candidate
                break

        panel_name = str(manifest.get("panel", "DevicePanel.qml"))
        modules.append(
            {
                "id": manifest.get("id", manifest_path.parent.name),
                "name": manifest.get("name", manifest_path.parent.name),
                "shortName": manifest.get("shortName", manifest.get("name", "Device")),
                "kind": manifest.get("kind", "device"),
                "connected": matched_device is not None,
                "panel": str((manifest_path.parent / panel_name).resolve()),
                "capabilities": manifest.get("capabilities", []),
                "usb": matched_device,
                "error": "",
            }
        )
    return modules


def main() -> None:
    inventory = usb_inventory()
    devices = load_modules(inventory)
    print(
        json.dumps(
            {
                "schemaVersion": 1,
                "devices": devices,
                "connectedCount": sum(bool(device.get("connected")) for device in devices),
                "registeredCount": len(devices),
            },
            separators=(",", ":"),
        )
    )


if __name__ == "__main__":
    main()

