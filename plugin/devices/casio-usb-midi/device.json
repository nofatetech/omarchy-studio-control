{
  "schemaVersion": 1,
  "id": "casio.usb-midi",
  "name": "Casio USB-MIDI Keyboard",
  "shortName": "Casio",
  "kind": "midi-keyboard",
  "panel": "DevicePanel.qml",
  "match": {
    "usb": [
      { "vendorId": "07cf", "productId": "6803" }
    ]
  },
  "access": {
    "defaultMode": "observe",
    "supportedModes": ["released", "observe", "managed"]
  },
  "capabilities": [
    "midi.input",
    "midi.output",
    "keyboard.keys.61",
    "keyboard.velocity",
    "pedal.sustain",
    "analysis.chord"
  ]
}
