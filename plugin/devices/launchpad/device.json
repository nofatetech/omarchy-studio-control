{
  "schemaVersion": 1,
  "id": "novation.launchpad-original",
  "name": "Novation Launchpad",
  "shortName": "Launchpad",
  "kind": "midi-controller",
  "panel": "DevicePanel.qml",
  "match": {
    "usb": [
      { "vendorId": "1235", "productId": "000e" }
    ]
  },
  "access": {
    "defaultMode": "observe",
    "supportedModes": ["released", "observe", "managed"]
  },
  "capabilities": [
    "midi.input",
    "midi.output",
    "led.red-green-amber",
    "grid.8x8"
  ]
}
